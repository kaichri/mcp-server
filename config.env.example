# Copy to config.env for Exa; keep the existing MCP_AUTH_TOKEN and deployment settings in .env.
# The MCP settings below remain reference values; Compose's environment block uses .env for them.
# Exa: leave key empty for Remote MCP. Never commit a populated key.
EXA_API_KEY=
EXA_PROVIDER=auto
EXA_QUOTA_COOLDOWN_SECONDS=3600
EXA_RATE_LIMIT_COOLDOWN_SECONDS=60
MCP_PUBLIC_BASE_URL=https://mcp.example.com
MCP_LAN_BIND_IP=<NAS_LAN_IP>
MCP_OAUTH_USERNAME=owner
MCP_X_CACHE_ENABLED=true
# For local Python execution; Compose stores this cache under /data.
MCP_X_CACHE_PATH=data/x-public.sqlite3
MCP_ALLOW_LEGACY_TOKEN=true
MCP_ACCESS_TOKEN_SECONDS=3600
MCP_REFRESH_TOKEN_SECONDS=63072000
MCP_AUTH_CODE_SECONDS=120
# Docker reads the Argon2id hash from secrets/oauth-password-hash.txt.
# Direct Python startup alternatively accepts MCP_OAUTH_PASSWORD_HASH_FILE.
