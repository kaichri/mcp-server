# Add these settings to your EXISTING .env. Keep the existing MCP_AUTH_TOKEN.
MCP_PUBLIC_BASE_URL=https://mcp.example.com
MCP_LAN_BIND_IP=<NAS_LAN_IP>
MCP_OAUTH_USERNAME=owner
MCP_ALLOW_LEGACY_TOKEN=true
MCP_ACCESS_TOKEN_SECONDS=900
MCP_REFRESH_TOKEN_SECONDS=2592000
MCP_AUTH_CODE_SECONDS=120
# Docker reads the Argon2id hash from secrets/oauth-password-hash.txt.
# Direct Python startup alternatively accepts MCP_OAUTH_PASSWORD_HASH_FILE.
